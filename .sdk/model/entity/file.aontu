# Entity: file

main: kit: entity: file: {

  alias: field: {}

  fields: [
    {
      name: "company"
      req: true
      short: "cuid-format identifier for this entity."
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "extension"
      req: true
      type: "`$STRING`"
    }
    {
      name: "file"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "cuid-format identifier for this entity."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "public"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "size"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "updated_at"
      req: true
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "file"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/files"
          parts: [
            "files"
          ]
          transform: {
            req: {
              file: "`reqdata`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
