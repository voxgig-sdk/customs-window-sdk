# BasicBulkUploadFlow

main: kit: flow: BasicBulkUploadFlow:
{
  entity: "bulk_upload",
  kind: "basic",
  name: "BasicBulkUploadFlow",
  step: [
    {
      input: {
        ref: "bulk_upload_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "bulk_upload_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "bulk_upload_ref01",
        srcdatavar: "bulk_upload_ref01_data",
        suffix: "_up0",
        textfield: "active_transport_nationality"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-bulk_upload_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "bulk_upload_ref01",
        srcdatavar: "bulk_upload_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "bulk_upload01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-bulk_upload_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "bulk_upload_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "bulk_upload01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "bulk_upload_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBulkUploadFlow"
}