# BasicPartyFlow

main: kit: flow: BasicPartyFlow:
{
  entity: "party",
  kind: "basic",
  name: "BasicPartyFlow",
  step: [
    {
      input: {
        ref: "party_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "party_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "party_ref01",
        srcdatavar: "party_ref01_data",
        suffix: "_up0",
        textfield: "bank_detail"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-party_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "party_ref01",
        srcdatavar: "party_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "party01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-party_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "party_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "party01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "party_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPartyFlow"
}