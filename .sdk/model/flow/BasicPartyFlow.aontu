# BasicPartyFlow

main: kit: flow: BasicPartyFlow:
{
  entity: "party",
  kind: "basic",
  name: "BasicPartyFlow",
  step: [
    {
      i: {
        ref: "party_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "party_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "party_ref01",
        srcdatavar: "party_ref01_data",
        suffix: "_up0",
        textfield: "bank_details"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-party_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "party_ref01",
        srcdatavar: "party_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "party01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-party_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "party_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "party01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "party_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPartyFlow"
}